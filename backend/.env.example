# Copia este archivo a .env y rellena tu clave de API-Football (RapidAPI)
API_FOOTBALL_KEY=
LEAGUE_ID=140
SEASON=2024
REWIND_MATCHDAY=8
CACHE_TTL_SECONDS=21600
DEMO_PLAYED_MATCHDAYS=8
CLUBELO_ENABLED=true
# CLUBELO_DATE=2024-08-14

# Orígenes permitidos por CORS (separados por comas).
# En producción añade el dominio del frontend, p. ej. https://simuliga.pages.dev
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# Fuente principal sin clave: OpenFootball + football-data.co.uk
DATA_SOURCE=openfootball
OPENFOOTBALL_SEASON=2026-27
PREVIOUS_OPENFOOTBALL_SEASON=2025-26
FOOTBALL_DATA_SEASON=2627
PREVIOUS_FOOTBALL_DATA_SEASON=2526

# SimuChampions
CHAMPIONS_LEAGUE_ID=2
CHAMPIONS_SEASON=2026
CHAMPIONS_PREVIOUS_SEASON=2025
# auto | api-football | openfootball | local | demo
CHAMPIONS_DATA_SOURCE=auto
CHAMPIONS_CLUBELO_DATE_2025=2025-08-01
CHAMPIONS_CLUBELO_DATE_2026=2026-08-01
CHAMPIONS_CACHE_TTL_SECONDS=21600
CHAMPIONS_SNAPSHOT_TTL_SECONDS=3600
CHAMPIONS_FALLBACK_REWIND_MATCHDAY=4
CHAMPIONS_CLUBELO_ENABLED=true
CHAMPIONS_HISTORY_SEASONS=5
CHAMPIONS_SEASON_REGRESSION=0.20
CHAMPIONS_CLUBELO_PRIOR_WEIGHT=0.75
# CHAMPIONS_API_FOOTBALL_KEY=

